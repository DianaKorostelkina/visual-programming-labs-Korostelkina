  {
    "id": "fn12a",
    "type": "function",
    "z": "tab12cx",
    "name": "counter++ (flow/global/env)",
    "func": "// 1) flow context: счётчик живёт между сообщениями\nlet count = flow.get(\"counter\") || 0;\ncount = count + 1;\nflow.set(\"counter\", count);\n\n// 2) global context: время последнего нажатия, доступно всем потокам\nglobal.set(\"lastRun\", new Date().toISOString());\n\n// 3) environment variables: значения заданы в свойствах потока\nmsg.payload = {\n    student: env.get(\"STUDENT_NAME\"),\n    group: env.get(\"STUDENT_GROUP\"),\n    counter: count\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
