    "id": "fn09",
    "type": "function",
    "z": "tab09db",
    "name": "temperature sensor",
    "func": "// имитация датчика температуры: плавное случайное изменение\nlet t = context.get(\"t\");\nif (t === undefined) {\n    t = 22;                       // стартовое значение\n}\n\nt = t + (Math.random() - 0.5) * 2;   // сдвиг от -1 до +1\n\nif (t < 15) { t = 15; }              // границы 15..30\nif (t > 30) { t = 30; }\n\ncontext.set(\"t\", t);\n\nmsg.payload = Math.round(t * 10) / 10;\nmsg.topic = \"Температура\";\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
