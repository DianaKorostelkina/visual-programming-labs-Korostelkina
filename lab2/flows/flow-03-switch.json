  {
    "id": "fn03sw",
    "type": "function",
    "z": "tab03sw",
    "name": "calc stats",
    "func": "const data = msg.payload;          // объект от inject\nconst numbers = data.numbers;      // массив чисел\n\nlet sum = 0;                       // сумма всех чисел\nlet evens = [];                    // массив чётных\n\nfor (let i = 0; i < numbers.length; i++) {\n    sum += numbers[i];\n    if (numbers[i] % 2 === 0) {\n        evens.push(numbers[i]);\n    }\n}\n\nconst average = sum / numbers.length;\n\nlet level;\nif (average > 10) {\n    level = \"high\";\n} else {\n    level = \"low\";\n}\n\nconst result = {                   // итоговый объект\n    surname: data.surname,\n    sum: sum,\n    average: average,\n    evenNumbers: evens,\n    level: level\n};\n\nreturn { payload: result, topic: \"lab2/Korostelkina/function\" };",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 150,
    "wires": [
      [
        "sw03"
      ]
    ]
  },
