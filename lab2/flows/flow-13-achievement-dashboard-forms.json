  {
    "id": "fnapply13",
    "type": "function",
    "z": "tab13fm",
    "name": "apply settings to flow context",
    "func": "// Форма прислала объект {threshold, topic, max}.\n// Сохраняем настройки в flow context: генератор подхватит их сразу, без redeploy.\nconst p = msg.payload;\n\nconst settings = {\n    threshold: Number(p.threshold),\n    topic: String(p.topic || \"sensor\"),\n    max: Number(p.max)\n};\n\nif (isNaN(settings.threshold)) { settings.threshold = 30; }\nif (isNaN(settings.max) || settings.max <= 0) { settings.max = 40; }\n\nflow.set(\"settings\", settings);\n\nmsg.payload = \"Применено: порог = \" + settings.threshold +\n              \", топик = \" + settings.topic +\n              \", максимум = \" + settings.max;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 100,
    "wires": [
      [
        "toast13"
      ]
    ]
  },
