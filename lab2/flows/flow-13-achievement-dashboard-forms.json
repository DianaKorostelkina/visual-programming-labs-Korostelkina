  {
    "id": "fngen13",
    "type": "function",
    "z": "tab13fm",
    "name": "generator (reads settings)",
    "func": "// Генератор читает настройки из flow context при КАЖДОМ срабатывании\nconst s = flow.get(\"settings\") || { threshold: 30, topic: \"sensor\", max: 40 };\n\nconst value = Math.round(Math.random() * s.max * 10) / 10;\n\nconst data = { topic: s.topic, payload: value };\n\nlet text;\nif (value > s.threshold) {\n    text = \"ПРЕВЫШЕНИЕ: \" + value + \" > \" + s.threshold;\n} else {\n    text = \"Норма: \" + value + \" <= \" + s.threshold;\n}\nconst status = { topic: s.topic, payload: text };\n\nreturn [data, status];   // выход 1: данные для gauge и chart, выход 2: статус",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 240,
    "wires": [
      [
        "gauge13",
        "chart13"
      ],
      [
        "text13"
      ]
    ]
  },
