        "name": "echo",
        "func": "const text = msg.payload.content;\n\n// команды (начинаются с \"/\") обрабатывают ноды command, их не повторяем\nif (typeof text !== \"string\" || text.startsWith(\"/\")) {\n    return null;\n}\n\nmsg.payload = {\n    chatId: msg.payload.chatId,\n    type: \"message\",\n    content: \"Вы написали: \" + text\n};\nreturn msg;",
